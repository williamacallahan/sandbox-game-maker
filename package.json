{
  "name": "game-maker",
  "type": "module",
  "bin": {
    "game-maker": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "dev:openrouter": "doppler run --no-check-version --silent --no-fallback --forward-signals=true --only-secrets OPENROUTER_API_KEY -- bun --watch src/cli.ts",
    "ui": "bun run src/server.ts",
    "ui:openrouter": "doppler run --no-check-version --silent --no-fallback --forward-signals=true --only-secrets OPENROUTER_API_KEY -- bun --watch src/server.ts",
    "ui:llm-gateway": "doppler run --no-check-version --silent --no-fallback --forward-signals=true --only-secrets LLM_API_KEY,LLM_BASE_URL -- bun --watch src/server.ts",
    "build": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1120.0",
    "@openrouter/agent": "0.11.0",
    "@openrouter/sdk": "0.13.67",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
